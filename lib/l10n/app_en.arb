    "description": "Title of the conversation list, which is the whole first screen in v1 (INB-19)."
  },
  "conversationPreviewWithSender": "{sender}: {text}",
  "@conversationPreviewWithSender": {
    "description": "Row preview for a group conversation, where the sender's name prefixes the message (INB-1). A one-to-one conversation shows the text alone.",
    "placeholders": {
      "sender": {
        "type": "String"
      },
      "text": {
        "type": "String"
      }
    }
  },
  "unreadCountOverflow": "99+",
  "@unreadCountOverflow": {
    "description": "Unread badge beyond 99; counts up to 99 are formatted as numbers by LANG-3 (INB-5)."
  },
  "deleteConversation": "Delete",
  "@deleteConversation": {
    "description": "The one control a swipe on a conversation row reveals (INB-6)."
  },
  "conversationDeleted": "Conversation deleted",
  "@conversationDeleted": {
    "description": "Snackbar shown for about five seconds after a swipe delete (INB-6, DEL-2)."
  },
  "inboxLoadFailed": "Replybox could not read your messages.",
  "@inboxLoadFailed": {
    "description": "Shown in place of the list when the read failed and there is nothing to draw. Never the exception: repository.dart composes a message containing a sender and a message's text, and no screen may put that on a screen or into a crash report (INB-24)."
  },
  "threadLoadFailed": "Replybox could not read this conversation.",
  "@threadLoadFailed": {
    "description": "Shown in place of the thread when its read failed and there is nothing to draw. Never the exception (INB-24)."
  },
  "includedAppsLoadFailed": "Replybox could not read your apps.",
  "@includedAppsLoadFailed": {
    "description": "Shown in place of the included-apps list when its read failed and there is nothing to draw. Never the exception (INB-24)."
  },
  "changeFailed": "That did not save. Nothing changed.",
  "@changeFailed": {
    "description": "Snackbar after a write that failed — a delete, an undo, or removing an app's stored messages. Says what happened without naming the conversation or quoting the exception (INB-24)."
  },
  "retry": "Try again",
  "@retry": {
    "description": "The one action beside a failure line: runs the read again."
  },
  "undo": "Undo",
  "@undo": {
    "description": "Action on the delete snackbar, which restores the conversation and all its messages in one step (INB-6, CAP-16)."
  },
  "threadHistoryNotice": "Replybox holds only what arrived as a notification. A message edited, unsent or deleted in the app it came from still reads here as it first arrived.",
  "@threadHistoryNotice": {
    "description": "First row of every thread, above the oldest message: a standing notice, not dismissible (INB-10, CAP-26)."
  },
  "threadHistorySince": "The earliest it could have seen this conversation is {date}.",
  "@threadHistorySince": {
    "description": "Part of the standing thread notice naming the first date anything here could have been captured (INB-10, CAP-12). The date is formatted by LANG-3 and passed in as text.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "threadHistoryAccessOffUntil": "Notification access was off until {date}, so nothing from before then is here.",
  "@threadHistoryAccessOffUntil": {
    "description": "Variant of the standing thread notice where no capture session existed before the first possible date (INB-10, CAP-12).",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "threadHistoryGaps": "{otherCount, plural, =0{Nothing could be captured here between {start} and {end}.} =1{Nothing could be captured here between {start} and {end}, and there is one other gap like it.} other{Nothing could be captured here between {start} and {end}, and there are {otherCount} other gaps like it.}}",
  "@threadHistoryGaps": {
    "description": "Part of the standing thread notice naming the most recent capture gap overlapping this thread and a count of the others; gaps under 60 seconds are not counted (INB-10, CAP-12).",
    "placeholders": {
      "start": {
        "type": "String"
      },
      "end": {
        "type": "String"
      },
      "otherCount": {
        "type": "int"
      }
    }
  },
  "threadHistoryRetention": "This thread reaches back to {date}. Older messages were here and Replybox removed them.",
  "@threadHistoryRetention": {
    "description": "Variant of the standing thread notice used instead of the first-possible date when a retention window is in force and is later than it (INB-10, area RET).",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "threadWindowed": "{count, plural, =1{This thread shows its newest message only. Older ones are stored and are not shown here.} other{This thread shows its newest {count} messages. Older ones are stored and are not shown here.}}",
  "@threadWindowed": {
    "description": "INB-10: the standing notice owns what this thread does not hold, and the read is bounded — so the window is stated rather than paged, because INB-10 forbids the top of the thread implying more can be loaded.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "threadConversationGone": "This conversation was deleted. There is nothing to show here.",
  "@threadConversationGone": {
    "description": "INB-6, INB-22 and DEL-1: the conversation was deleted while its thread was open — swiped from the list, or removed with its app's stored messages. It may still be inside its five-second Undo window, so the line says it was deleted and never that it is gone for good. Names no title and no sender (INB-24)."
  },
  "messageImage": "Photo",
  "@messageImage": {
    "description": "Placeholder drawn in place of a message whose content_kind is image, in the thread and as the row preview (INB-11, CAP-9)."
  },
  "messageVoice": "Voice message",
  "@messageVoice": {
    "description": "Placeholder for a message whose content_kind is voice (INB-11, CAP-9)."
  },
  "messageVideo": "Video",

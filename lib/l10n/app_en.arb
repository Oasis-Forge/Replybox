    "description": "Placeholder for a message whose content_kind is file (INB-11, CAP-9)."
  },
  "messageOther": "Something Replybox cannot show",
  "@messageOther": {
    "description": "Placeholder for a message whose content_kind is other: the app says only that something arrived, never what (INB-11, CAP-9)."
  },
  "rawConversationNotice": "Replybox saw a notification from this app, but not a conversation. Each line below is the notification's own title and text, as the phone delivered them. Nothing was added and nothing was inferred.",

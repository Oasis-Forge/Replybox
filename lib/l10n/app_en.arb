    "description": "Shown on a conversation row whose notification arrived without a name (INB-2)."
  },
  "conversationNoMessages": "No messages here",
  "@conversationNoMessages": {
    "description": "The row's preview line where the conversation holds no message to preview — every message soft-deleted (DEL-1), or last_message_at sitting past everything stored. Said rather than left blank, so the gap has a name on it (INB-1, product principle 3)."
  },
  "messageHidden": "Your phone hid this message. Open it in the app it came from.",
  "@messageHidden": {
    "description": "Shown in place of a message Android hid from the app (CAP-8, INB-3)."
  },
  "openInApp": "Open in app",
  "@openInApp": {
    "description": "Action on a row with no live reply action (INB-13, CAP-14)."
  },
  "inboxTitle": "Inbox",

    "description": "The application's title."
  },
  "inboxEmptyNothingYet": "Nothing yet. Messages from the apps you have included will appear here.",
  "@inboxEmptyNothingYet": {
    "description": "Body of the Nothing yet empty state where no app label resolves, so none can be named (INB-15, RUN-1)."
  },
  "inboxEmptyNothingYetApps": "{othersCount, plural, =0{Messages from {apps} will appear here.} =1{Messages from {apps} and 1 more app will appear here.} other{Messages from {apps} and {othersCount} more apps will appear here.}}",

  "sourceAppNotOpenable": "Replybox cannot open {app}.",
  "@sourceAppNotOpenable": {
    "description": "Shown in the thread's bottom bar in place of INB-13's control, where nothing this process holds can open the source app and the package is outside the manifest's queries declaration: no launcher intent can resolve without the package visibility INB-20 refuses, so a control there could only ever fail. Says less rather than guessing, and names no uninstall (INB-16).",
    "placeholders": {
      "app": {
        "type": "String"
      }
    }
  },

  "includedAppsMissingNote": "An app is missing until it posts a notification. Replybox never lists the apps on your phone, so it learns about one the first time it posts.",
  "@includedAppsMissingNote": {
    "description": "Permanent line at the bottom of the included-apps list, so an absent app reads as a stated limit rather than a bug (INB-21, INB-20, product principle 3)."
  },
  "includedAppsSwitchExplainer": "Off means the next notification this app posts is not stored. What is already here stays.",
  "@includedAppsSwitchExplainer": {
    "description": "Stated beside the switch, which is the whole confirmation of turning a row off (INB-22, CAP-1)."
  },
  "includedAppsSwitchOnNotLive": "Saved here, but the notification listener has not been told yet. Messages from this app can still be missed until Replybox is opened again.",
  "@includedAppsSwitchOnNotLive": {
    "description": "INB-22: the row and the database moved but CAP-1's filter did not hear it, and the row was switched on — so the listener goes on dropping this package's notifications and those messages are lost rather than delayed. Drawn on the row it happened to. Never the exception (INB-24)."
  },
  "includedAppsSwitchOffNotLive": "Saved here, but the notification listener has not been told yet. Messages from this app can still be stored until Replybox is opened again.",
  "@includedAppsSwitchOffNotLive": {
    "description": "INB-22: the same failure with the row switched off — the listener goes on capturing from this package until the next launch or resume re-mirrors. Drawn on the row it happened to. Never the exception (INB-24)."
  },
  "includedAppsRemoveMessages": "Remove stored messages",

<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- SpikeRawPoster needs this to post at all from API 33 up. PERM-15 forbids
         it in the RELEASE build until the release that first ships a snooze, and
         the debug source set is exactly where a permission that must never reach
         a release build belongs; INTERNET is here on the same footing. Nothing
         merges this into the release manifest: check with
         `grep POST_NOTIFICATIONS android/app/build/intermediates/merged_manifests/release/*/AndroidManifest.xml`
         and expect no match. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application>
        <!-- Capture spike for docs/PLAN.md section 5, and throwaway with it.
             It lives in the debug source set so no part of it can reach a
             release build: the spike is scaffolding for deciding the capture
             rules, not a shipped feature, and release.yml's permission gate
             should never have to reason about it.

             BIND_NOTIFICATION_LISTENER_SERVICE is declared here as the
             permission the *system* must hold to bind this service, which is
             what makes the service safe to export. It is not a uses-permission
             and so does not appear in the app's permission list either way. -->
        <service
            android:name=".spike.SpikeListenerService"
            android:exported="true"
            android:label="Replybox capture spike"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- Check 5: fires a reply action that was held after its notification
             was dismissed. Exported so `adb shell am broadcast` can reach it;
             debug-only, so nothing exported here exists in a release build. -->
        <receiver
            android:name=".spike.SpikeReplyReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.oasisforge.replybox.SPIKE_REPLY"/>
                <action android:name="com.oasisforge.replybox.SPIKE_DISMISS"/>
            </intent-filter>
        </receiver>

        <!-- CAP-21, CAP-6, CAP-7, CAP-8: posts the notification shapes nothing on
             the device can otherwise produce, because `cmd notification post` has
             no category flag and no installed app posts a non-MessagingStyle
             msg/social/email notification on demand. Exported so
             `adb shell am broadcast` can reach it; debug-only, so nothing exported
             here exists in a release build and release.yml's permission gate never
             sees it (CAP-20, PERM-15). -->
        <receiver
            android:name=".spike.SpikeRawPoster"
            android:exported="true">
            <!-- SPIKE_BRIDGE switches SpikeCaptureBridge on and off. It is off on
                 every fresh install and after every `spike.sh reset`, and this
                 broadcast is the only thing that turns it on. The bridge itself is
                 a debug-source-set class that reaches the shipped capture path
                 through its public API; nothing in src/main knows it exists, and
                 OwnPackageGuardTest fails if that ever stops being true
                 (PERM-12). -->
            <intent-filter>
                <action android:name="com.oasisforge.replybox.SPIKE_POST"/>
                <action android:name="com.oasisforge.replybox.SPIKE_POST_REPLY"/>
                <action android:name="com.oasisforge.replybox.SPIKE_BRIDGE"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>

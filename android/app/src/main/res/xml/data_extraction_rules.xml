<?xml version="1.0" encoding="utf-8"?>
<!-- CAP-24: automatic cloud backup and device-to-device transfer must never
     copy the message database or the native queue off the phone. Excluding
     both domains here is what makes "everything stays on your phone" true. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>

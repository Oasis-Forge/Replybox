<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="replybox"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">
        <!-- CAP-24: Android's automatic cloud backup is on by default and would
             upload the message database to the user's Google Drive, which would
             make the privacy policy's "everything stays on your phone" untrue. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- CAP-20: notification access is a service declaration, not a requested
             permission. android:permission names the permission the *system* must
             hold to bind this service, which is what makes exporting it safe; it is
             not a <uses-permission> and never appears in the app's permission list,
             so RUN-2's gate in release.yml stays green with an empty ALLOWED. No
             <uses-permission> element belongs in this file for capture, or that gate
             fails the release build.

             No android:label: the system's notification-access page falls back to
             the application label, and a label here could not come from the message
             files (LANG-2) and so would ship untranslated. -->
        <service
            android:name=".capture.ReplyboxListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- INB-13, INB-16 (developer decision, 22 September 2026): every app
             that has a launcher icon.

             Without this, `getLaunchIntentForPackage` answered null for every
             package outside the six below, so INB-13's `Open <app>` was a
             control that failed every time for exactly the apps INB-20's second
             source is made of - the ones that joined the inbox by posting a
             notification. The same visibility is what lets INB-16 tell
             `installed` from `gone` for those apps instead of withholding both.

             What it widens, stated rather than left to be found. Android now
             makes every launchable app *visible* to this process: a package
             manager lookup for one of them resolves instead of throwing. That
             is not QUERY_ALL_PACKAGES (which is still absent, and which
             tool/check_queries.sh and RUN-2's gate both fail on), it needs no
             permission, and it enumerates nothing on its own - PackageManager
             answers one named package at a time and only when it is asked.

             So what keeps the app from reading the phone's app list is a rule
             in code, not this element: SourceAppInfo.lookup refuses any package
             that is neither named below nor one this install's CaptureStore has
             already seen post a notification, and SourceAppInfoTest fails if
             that gate is weakened. The privacy policy says both halves - what
             the app can see, and what it chooses to ask (CAP-27). -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <!-- INB-16, INB-20: the shipped messaging apps. Still named one by one
             even though the filter above already makes them visible, because
             the two declarations do different work. The filter covers an app
             while it has a launcher activity; these entries cover these six
             whatever shape they are in, which is what makes a NameNotFound for
             one of them mean "uninstalled" and nothing else - and PERM-3's
             disclosure resolves their labels before any of them has posted.
             This list must stay in step with lib/data/shipped_apps.dart and
             with ShippedApps.PACKAGES in
             android/app/src/main/kotlin/com/oasisforge/replybox/capture/ShippedApps.kt,
             which is the copy CAP-1's native filter defaults on. PERM-3 fails
             if any package can start enabled whose label the disclosure never
             showed, so the three are one set and one test covers all of them. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.instagram.android" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.google.android.apps.messaging" />
    </queries>
</manifest>
